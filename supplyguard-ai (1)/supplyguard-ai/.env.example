# Optional overrides for `docker compose up`. Copy this to `.env` in the
# project root (same folder as docker-compose.yml) to customize — otherwise
# docker-compose.yml uses the defaults shown below automatically.
#
# NOTE: this is separate from src/backend/.env.example, which is only used
# when running the backend directly with `npm run dev` (no Docker).

JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=8h

DEMO_USER_EMAIL=[email protected]
DEMO_USER_PASSWORD=supplyguard123

WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2
