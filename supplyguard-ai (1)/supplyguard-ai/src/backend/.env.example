PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string (recommended for production and shared environments)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/supplyguard?retryWrites=true&w=majority
# For local Docker runs, keep MONGO_URI as the Mongo container URL or leave it blank to use the default below.
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxxx.mongodb.net/supplyguard?retryWrites=true&w=majority

# JWT auth
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=8h

# Permanent login defaults
ADMIN_EMAIL=admin@supplyguard.ai
ADMIN_PASSWORD=SupplyGuard@2026
SHIPMENT_USER_EMAIL=shipmentuser@supplyguard.ai
SHIPMENT_USER_PASSWORD=Shipment@2026

# IBM Bob Copilot / watsonx.ai — leave blank to use the built-in
# rule-based copilot fallback
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2
