PORT=5000
NODE_ENV=development

# MongoDB (falls back to in-memory mock data if unreachable — see src/config/db.js)
MONGO_URI=mongodb://mongo:27017/supplyguard

# JWT auth
JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=8h

# Demo login (seeded on first run if no users exist)
DEMO_USER_EMAIL=[email protected]
DEMO_USER_PASSWORD=supplyguard123

# IBM Bob Copilot / watsonx.ai — leave blank to use the built-in
# rule-based copilot fallback
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2
