# Optional overrides for `docker compose up`. Copy this to `.env` in the
# project root (same folder as docker-compose.yml) to customize — otherwise
# docker-compose.yml uses the defaults shown below automatically.
#
# NOTE: this is separate from src/backend/.env.example, which is only used
# when running the backend directly with `npm run dev` (no Docker).
#
# Default permanent accounts:
#   Main Admin: admin@supplyguard.ai / SupplyGuard@2026
#   Shipment User: shipmentuser@supplyguard.ai / Shipment@2026
# You only need to set these if you want to override the defaults.
#
# For MongoDB Atlas, set MONGO_URI to a real Atlas connection string instead of the local Docker URL.

JWT_SECRET=change-this-in-production
JWT_EXPIRES_IN=8h

ADMIN_EMAIL=admin@supplyguard.ai
ADMIN_PASSWORD=SupplyGuard@2026
SHIPMENT_USER_EMAIL=shipmentuser@supplyguard.ai
SHIPMENT_USER_PASSWORD=Shipment@2026
MONGO_URI=mongodb+srv://Supplyguard_ai:uyQ2iPvfX4KBqeX@cluster0.egfwl15.mongodb.net/?appName=Cluster0
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-instruct-v2
